<?xml version="1.0"?>
<ruleset name="Housing Offers API">
    <description>PSR-12 verification for first-party PHP.</description>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <file>app</file>
    <file>bootstrap</file>
    <file>config</file>
    <file>database</file>
    <file>public</file>
    <file>routes</file>
    <file>tests</file>
    <exclude-pattern>bootstrap/cache/*</exclude-pattern>
    <rule ref="PSR12"/>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>public/index.php</exclude-pattern>
    </rule>
</ruleset>
